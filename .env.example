# Copy to .env and fill in to run the collector against real eBay prices.
#
#   cp .env.example .env
#   docker compose --profile live run --rm collector-live
#
# Both values come from one Production keyset at
# https://developer.ebay.com/my/keys — App ID is the client id, Cert ID is the
# client secret. See "Running against real prices" in the README.

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional. Only set this if you hold a PriceCharting subscription AND their
# written permission to display the data. See the README before enabling it.
# PRICECHARTING_TOKEN=
