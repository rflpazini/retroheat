# Copy to .env and fill in to run the collector against real eBay prices.
#
#   cp .env.example .env
#   docker compose --profile live run --rm collector-live
#
# Both values come from one Production keyset at
# https://developer.ebay.com/my/keys — App ID is the client id, Cert ID is the
# client secret. See "Running against real prices" in the README.

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional. Point the client at the eBay sandbox to exercise the pipeline with
# a Sandbox keyset while a Production keyset is pending. Sandbox listings are
# test data, not real prices, so leave this unset for anything you publish.
# EBAY_BASE_URL=https://api.sandbox.ebay.com

# Optional. Only set this if you hold a PriceCharting subscription AND their
# written permission to display the data. See the README before enabling it.
# PRICECHARTING_TOKEN=

# Optional. With both set, the collector also writes every run's points to the
# Supabase copy of the history, and `go run ./cmd/mirror` can backfill or
# restore it. The service_role key bypasses row-level security: it is a
# secret, never the anon key, and never goes into the site.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# The site has its own optional variables; see web/.env.example.
